# mako — neon notifications in tyr's look (the layer is blurred by hyprland.lua)
# pink border = normal, cyan = low, yellow = urgent (stays until dismissed)
sort=-time
layer=overlay
background-color=#0b0d17e0
text-color=#d8dee9
border-color=#ff4fa3
progress-color=over #2de2e655
border-size=2
border-radius=14
padding=14
margin=16
default-timeout=6000
font=JetBrainsMono Nerd Font 11
format=<span foreground="#2de2e6"><b>%s</b></span>\n%b
anchor=top-right
width=360
height=140
icons=1
max-icon-size=48

[urgency=low]
border-color=#2de2e6

[urgency=high]
border-color=#ebcb8b
default-timeout=0
