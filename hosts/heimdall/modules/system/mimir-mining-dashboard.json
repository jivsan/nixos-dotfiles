{
  "uid": "mimir-mining",
  "title": "mimir mining",
  "description": "pearl mining on mimir's 4060 ti (krig, kryptex). numbers from krig-yield (hosts/mimir/modules/system/krig-miner.nix) and the gpu exporter",
  "tags": ["mimir", "mining", "gpu"],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "price",
        "label": "kr per kWh (what I pay, grid fee included)",
        "query": "0.89",
        "current": { "selected": false, "text": "0.89", "value": "0.89" },
        "options": [ { "selected": true, "text": "0.89", "value": "0.89" } ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Miner",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "krig_mining{host=\"mimir\"} + 2 * krig_card_busy{host=\"mimir\"}", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "background", "graphMode": "none", "textMode": "value", "justifyMode": "center" },
      "fieldConfig": {
        "defaults": {
          "noValue": "Stopped",
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": [
            { "type": "value", "options": {
              "0": { "text": "Waiting (card free)", "color": "blue", "index": 0 },
              "1": { "text": "Mining", "color": "green", "index": 1 },
              "2": { "text": "Paused (card busy)", "color": "orange", "index": 2 },
              "3": { "text": "Pausing", "color": "orange", "index": 3 }
            } }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Hashrate",
      "gridPos": { "x": 4, "y": 0, "w": 5, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "krig_hashrate_hashes_per_second{host=\"mimir\"}" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "fieldConfig": { "defaults": { "unit": "Hs", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Card power now",
      "gridPos": { "x": 9, "y": 0, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "nvidia_smi_power_draw_watts{host=\"mimir\"}" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "area", "textMode": "value" },
      "fieldConfig": { "defaults": { "unit": "watt", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "yellow" } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Energy while mining",
      "description": "the card's power while the miner ran, over the time range at the top",
      "gridPos": { "x": 13, "y": 0, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum_over_time((nvidia_smi_power_draw_watts{host=\"mimir\"} * on(host) krig_mining{host=\"mimir\"})[$__range:1m]) / 60 / 1000", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "fieldConfig": { "defaults": { "unit": "kwatth", "decimals": 2, "noValue": "0", "color": { "mode": "fixed", "fixedColor": "yellow" } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Power cost",
      "description": "energy while mining × the kr per kWh at the top",
      "gridPos": { "x": 17, "y": 0, "w": 3, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "sum_over_time((nvidia_smi_power_draw_watts{host=\"mimir\"} * on(host) krig_mining{host=\"mimir\"})[$__range:1m]) / 60 / 1000 * $price", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "fieldConfig": { "defaults": { "unit": "suffix: kr", "decimals": 2, "noValue": "0", "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Shares",
      "description": "shares the pool answered, over the time range at the top",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "round(sum(increase(krig_shares_total{host=\"mimir\", result=\"accepted\"}[$__range])))", "legendFormat": "accepted", "instant": true },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "round(sum(increase(krig_shares_total{host=\"mimir\", result=~\"stale|rejected\"}[$__range])))", "legendFormat": "stale + rejected", "instant": true }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name", "orientation": "vertical" },
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0, "noValue": "0", "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": [ { "matcher": { "id": "byName", "options": "stale + rejected" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] } ]
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Hashrate",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "krig_hashrate_hashes_per_second{host=\"mimir\"}", "legendFormat": "hashrate" }
      ],
      "options": { "legend": { "showLegend": false }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "Hs", "min": 0, "color": { "mode": "fixed", "fixedColor": "green" }, "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" } }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Card power and temperature",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "nvidia_smi_power_draw_watts{host=\"mimir\"}", "legendFormat": "power" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "nvidia_smi_temperature_gpu{host=\"mimir\"}", "legendFormat": "temperature" },
        { "refId": "C", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "nvidia_smi_fan_speed_ratio{host=\"mimir\"} * 100", "legendFormat": "fan %" }
      ],
      "options": { "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "watt", "min": 0, "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "power" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } } ] },
          { "matcher": { "id": "byName", "options": "temperature" }, "properties": [ { "id": "unit", "value": "celsius" }, { "id": "custom.axisPlacement", "value": "right" }, { "id": "max", "value": 100 }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "fan %" }, "properties": [ { "id": "unit", "value": "percent" }, { "id": "custom.axisPlacement", "value": "hidden" }, { "id": "max", "value": 100 }, { "id": "custom.fillOpacity", "value": 0 }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] }
        ]
      }
    },
    {
      "id": 9,
      "type": "state-timeline",
      "title": "Mining and other work on the card",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "krig_mining{host=\"mimir\"}", "legendFormat": "miner" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "krig_card_busy{host=\"mimir\"}", "legendFormat": "other work" }
      ],
      "options": { "showValue": "never", "mergeValues": true, "rowHeight": 0.8, "legend": { "showLegend": false } },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "transparent" },
          "mappings": [ { "type": "value", "options": { "0": { "text": "off", "color": "transparent", "index": 0 }, "1": { "text": "on", "color": "green", "index": 1 } } } ]
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "other work" }, "properties": [ { "id": "mappings", "value": [ { "type": "value", "options": { "0": { "text": "free", "color": "transparent", "index": 0 }, "1": { "text": "busy", "color": "orange", "index": 1 } } } ] } ] }
        ]
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Card memory",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "nvidia_smi_memory_used_bytes{host=\"mimir\"}", "legendFormat": "used" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "nvidia_smi_memory_total_bytes{host=\"mimir\"}", "legendFormat": "total" }
      ],
      "options": { "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0, "custom": { "fillOpacity": 15, "lineWidth": 2, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "used" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } } ] },
          { "matcher": { "id": "byName", "options": "total" }, "properties": [ { "id": "custom.fillOpacity", "value": 0 }, { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "text" } } ] }
        ]
      }
    }
  ]
}
